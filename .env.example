# copy to .env and fill in
GOOGLE_CLOUD_PROJECT=inboxiq-dev
GOOGLE_CLIENT_SECRETS=secrets/oauth_client.json
GOOGLE_APPLICATION_CREDENTIALS=secrets/firestore_sa.json
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
FRONTEND_URL=http://localhost:5180
OAUTH_TOKEN_STORE=secrets/tokens
FIRESTORE_DATABASE=(default)

# Satwik only - classifier. Free key at console.groq.com/keys
GROQ_API_KEY=

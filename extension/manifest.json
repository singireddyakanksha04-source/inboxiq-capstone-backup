{
  "manifest_version": 3,
  "name": "InboxIQ for Gmail",
  "version": "0.2.5",
  "description": "Sorts the Gmail inbox into InboxIQ mailboxes - bills, codes, security, promotions and the rest - inside Gmail's own sidebar.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "InboxIQ"
  },
  "key": "",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/",
    "https://api.groq.com/"
  ],
  "oauth2": {
    "client_id": "948915820665-oa6t4i8biv1l6mh1ollrm36u3k29cp3k.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "src/categories.js",
        "src/panel.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel.css"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ]
}
